# Copia este archivo como .env.local y rellena los valores. Nunca subas .env.local al repositorio.

# Base de datos (Neon / Supabase / Postgres local)
DATABASE_URL="postgresql://usuario:clave@host:5432/crm_seo?sslmode=require"

# Auth.js
AUTH_SECRET="genera-uno-con: npx auth secret"
AUTH_URL="http://localhost:3000"

# Usuaria admin que crea el seed (npx prisma db seed). Contraseña de al menos 10 caracteres.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Cifrado de tokens de canales (32 bytes en base64: openssl rand -base64 32)
ENCRYPTION_KEY=""

# Meta (WhatsApp Cloud API, Facebook, Instagram)
META_APP_ID=""
META_APP_SECRET=""
META_EMBEDDED_SIGNUP_CONFIG_ID=""
META_GRAPH_VERSION="v23.0"   # usa la versión vigente que indique Meta
WHATSAPP_VERIFY_TOKEN="un-texto-largo-aleatorio"

# Jobs
CRON_SECRET="otro-texto-aleatorio"

# URL pública (para webhooks)
APP_URL="http://localhost:3000"
